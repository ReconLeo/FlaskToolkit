# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---------- FlaskToolkit 运行时数据（首次启动自动生成，无需提交） ----------
# 统计数据 / 审计日志 / 用户配置 / 首次自检标记
data/stats.json
data/audit.log
data/user_config.json
data/.initialized
data/*.json
# HTTPS 自签名证书/私钥（tools/gen_cert.py 生成，私钥敏感不提交）
data/certs/
# 日志与临时目录
logs/
temp/
backups/
.plugin_cache/
# 插件运行时状态（auth 首次启动自动重建 admin/admin123）
plugins/data/
plugins/temp/
# 插件运行时配置（auth 首次启动自动重建；hello_plugin 等插件配置均不入库）
plugins/configs/*.json
plugins/status.json

# ---------- 沙箱/探针残留 ----------
_t_hook.txt

# ---------- AI 助手本地数据骨架（users/ 非项目内容，保留本地不入库） ----------
users/
data/.write_probe
data/.*

# ---------- 示例打包产物（install_all.py --pack-only 生成） ----------
examples/dist/

# ---------- 历史版本文档归档（开源仓库仅保留当前版本 v4.0 / Roadmap / 指南） ----------
# 历史版本文档统一归档在 documents/archive/（不入库），当前文档保留在 documents/ 根目录
documents/archive/

# ---------- Kaleido / AirDrop 插件子项目本地产物（不入主仓库） ----------
plugins/kaleido_*.py
plugins/kaleido_*.json
templates/plugins/kaleido_*/
templates/frontend_tools/kaleido_*.html
templates/frontend_tools/static/
# AirDrop（局域网文件共享）独立子项目插件落地文件（不入主仓库）
plugins/airdrop.py
plugins/airdrop.json
templates/plugins/airdrop/
templates/plugins/static/airdrop/
frontend_tools.json  # 前端工具注册清单（运行时配置，install_all/上传时重建）
.version

# ---------- 灵犀会话工作区残留 / 插件默认目录缓存 ----------
/20*/
__NEW_PLUGIN_DEFAULT__/
# 测试运行时产物（test_file_transfer 下载样例 / test_security 备份等，运行自动重建）
tests/fixtures/

# ---------- 操作系统 / 编辑器 ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
